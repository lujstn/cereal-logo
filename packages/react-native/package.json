{
  "name": "@lujstn/cereal-logo-react-native",
  "version": "1.1.0",
  "description": "Animated Cereal logo for React Native: a balloon-inflate Lottie wordmark with flow / split / bloom / random modes.",
  "license": "UNLICENSED",
  "author": "lujstn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lujstn/cereal-logo.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://github.com/lujstn/cereal-logo#readme",
  "bugs": {
    "url": "https://github.com/lujstn/cereal-logo/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "react-native": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-native": ">=0.64",
    "lottie-react-native": ">=6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "lottie-react-native": "^7.3.0",
    "react": "^19.2.0",
    "react-native": "^0.86.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  },
  "keywords": ["cereal", "logo", "lottie", "animation", "react-native", "wordmark"],
  "publishConfig": {
    "access": "public"
  }
}
